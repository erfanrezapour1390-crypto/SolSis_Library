<Application x:Class="SolSis.Library.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0B0D12"/>
        <SolidColorBrush x:Key="Panel" Color="#121620"/>
        <SolidColorBrush x:Key="Card" Color="#171C27"/>
        <SolidColorBrush x:Key="CardHover" Color="#1E2533"/>
        <SolidColorBrush x:Key="Text" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="Muted" Color="#8D97A8"/>
        <SolidColorBrush x:Key="Accent" Color="#7C5CFF"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>
